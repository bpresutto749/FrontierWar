timestamp=2026-11-14T13:37:50.582Z level=INFO run=0eae07f9 message=evaluated permission=bash pattern="cat > conf.py <<'EOF'\nimport re,subprocess,ast\nT=open('tmpl.red').read()\nlines=[l for f in ['s11.log','s12.log','s13.log','s14.log'] for l in open(f) if l[0].isdigit()]\nc=sorted(lines,key=lambda l:-float(l.split()[1]))[:6]\nfor l in c:\n    v=ast.literal_eval(l[l.index('{'):])\n    s=T\n    for k,x in v.items(): s=s.replace('$'+k,str(x))\n    open('c.red','w').write(s)\n    out=subprocess.run(['python3','/app/tools/spar.py','c.red','--rounds','500'],capture_output=True,text=True).stdout\n    print(re.search(r'MEAN\\s+([\\d.]+)',out).group(1),v,flush=True)\nEOF" action.permission=* action.action=allow action.pattern=*
