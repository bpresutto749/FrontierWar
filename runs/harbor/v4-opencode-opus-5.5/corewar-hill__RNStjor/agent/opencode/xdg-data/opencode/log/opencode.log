timestamp=2026-11-14T13:44:54.416Z level=INFO run=e452194b message=evaluated permission=bash pattern="cat > sw2.red <<'EOF'\n;redcode-94\n;name Weighed Choice\n;author opencode\n;strategy explore scanner and paper/stone/imp for K rounds each, then keep the better\n;assert CORESIZE==8000\nK       equ    15\nstep    equ    7019\nist     equ    2667\nstart   ldp.ab #0,     r\n        ldp.ab #1,     n\n        ldp.ab #4,     last\n        ldp.ab #2,     sa\n        ldp.ab #3,     sbb\n        jmz.b  upd,    n\n        slt.ab #2*K,   n\n        jmp    score\n        jmp    upd\nscore   mul.ab #3,     r\n        mod.ab #5,     r\n        jmn.b  addb,   last\n        add.b  r,      sa\n        stp.b  sa,     #2\n        jmp    upd\naddb    add.b  r,      sbb\n        stp.b  sbb,    #3\nupd     add.ab #1,     n\n        stp.b  n,      #1\n        slt.ab #K,     n\n        jmp    playa\n        slt.ab #2*K,   n\n        jmp    playb\n        slt.b  sa,     sbb\n        jmp    playa\nplayb   stp.ab #1,     #4\n        jmp    paperc\nplaya   stp.ab #0,     #4\n        jmp    scan\nr       dat    0,      0\nn       dat    0,      0\nlast    dat    0,      0\nsa      dat    0,      0\nsbb     dat    0,      0\n\npaperc  spl    paper\n        spl    1\n        spl    1\n        spl    1\ntbst    spl    stone\n        spl    1\n        spl    1\n        spl    2\n        jmp    @0,     imp\n        add    #ist,   -1\n        dat    0,      0\nstone   spl    #0,     0\nlp      mov    stb,    *p\n        mov    stb,    @p\n        add.f  inc2,   p\n        djn.f  lp,     <-1000\np       dat    step,   step*2\ninc2    dat    step*2, step*2\nstb     dat    >-1,    >1\nimp     mov.i  #0,     ist\npaper   spl    1,      0\n        spl    1,      0\n        spl    1,      0\ns1      spl    @0,     <3728\n        mov.i  }-1,    >-1\ns2      spl    @0,     <5430\n        mov.i  }-1,    >-1\ns3      spl    @0,     <3423\n        mov.i  }-1,    >-1\n        mov.i  bmb,    }2667\n        mov.i  bmb,    >764\n        mov.i  {-8,    <1\n        jmz.a  @0,     }-9\nbmb     dat    <2667,  <5334\n\ninc     dat    3359,   3359\nscan    add.f  inc,    ptr\nptr     sne.i  3359,   3609\ncnt     djn.b  scan,   #800\n        jmz.b  clear,  cnt\n        mov.a  ptr,    tmp\n        add.a  #262,   tmp\n        slt.a  #290,   tmp\n        jmp    scan\n        mov    sjb,    *ptr\n        mov    sjb,    @ptr\n        mov.ab ptr,    gate\n        add.b  #ptr-gate-0, gate\n        jmp    clear\ntmp     dat    0,      0\nsjb     jmp    0,      0\ngate    dat    0,      0\nclear   spl    #0,     0\n        mov    db,     >gate\n        djn.f  -1,     >gate\ndb      dat    <2667,  2-gate\n        end    start\nEOF" action.permission=* action.action=allow action.pattern=*
