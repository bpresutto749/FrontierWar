timestamp=2026-11-14T13:31:42.522Z level=INFO run=e452194b message=evaluated permission=bash pattern="cat > gen.py <<'EOF'\nimport sys\nN=int(sys.argv[1]) if len(sys.argv)>1 else 20\nD=int(sys.argv[2]) if len(sys.argv)>2 else 4000\nbase=int(sys.argv[3]) if len(sys.argv)>3 else 0\nbody=open(sys.argv[4] if len(sys.argv)>4 else 'body.red').read()\nlines=[]\n# layout: 2N scan lines, then jmz, attack..., then body\nnscan=2*N\n# indices\njz=nscan\natt=jz+1\n# attack block\nattack=[\n \"mov.ba ptr, ptr\",\n \"add.a #%d, ptr\"%D,\n \"sub.f eight, ptr\",\n \"lp mov bmb, *ptr\",\n \"mov bmb, @ptr\",\n \"add.f two, ptr\",\n \"djn.b lp, #12\",\n \"jmp go\",\n \"ptr dat 0, 0\",\n \"two dat 2, 2\",\n \"eight dat 8, 8\",\n \"bmb dat 0, 0\",\n]\nptr_idx=att+8\ntotal=200 # rough length\nspread=(8000-300)//N\nout=[]\nfor i in range(N):\n    P=150+total+base+i*spread  # absolute offset from line 0\n    P%=8000\n    j=2*i\n    out.append(\"seq.i %d, %d\"%(P-j, P+D-j))\n    out.append(\"mov.ab #%d, %d\"%(P-ptr_idx, ptr_idx-(j+1)))\nout.append(\"jmz.b go, ptr\")\nout+=attack\nsrc=\";redcode-94\\n;name Pebble Spiral Q\\n;author opencode\\n;assert CORESIZE==8000\\n\"\nsrc+=\"\\n\".join(\"        \"+l if not l.split()[0] in(\"lp\",\"ptr\",\"two\",\"eight\",\"bmb\") else l for l in out)+\"\\n\"\nsrc+=body\nprint(src)\nEOF" action.permission=* action.action=allow action.pattern=*
