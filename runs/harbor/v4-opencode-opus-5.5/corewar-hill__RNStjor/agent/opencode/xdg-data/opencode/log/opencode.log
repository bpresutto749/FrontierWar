timestamp=2026-11-14T13:38:31.681Z level=INFO run=e452194b message=evaluated permission=bash pattern="python3 - <<'EOF'\nsc=open('best1.red').read().split('\\n')\nbody=[l for l in sc if l and not l.startswith(';') and not l.strip().startswith('end')]\ntb=open('/tmp/w/tb.red').read().split('\\n')\ntbb=[l for l in tb if l and not l.startswith(';') and not l.strip().startswith('end')]\n# rename labels in tb to avoid clash\nimport re\nren={'stone':'stn','lp':'slp','p':'sp','inc':'sinc','bomb':'sbomb','imp':'simp','step':'sstep','ist':'sist'}\ndef r(l):\n    return re.sub(r'\\b(\\w+)\\b', lambda m: ren.get(m.group(1),m.group(1)), l)\ntbb=[r(l) for l in tbb]\ntbb[2]= 'tbst '+tbb[2].lstrip() if False else tbb[2]\nsw=\"\"\";redcode-94\n;name Sentinel Switch\n;author opencode\n;assert CORESIZE==8000\nSTATE   equ     7\nsw      ldp.ab  #0, in\n        ldp.ab  #STATE, sel\n        sne.ab  #0, in\n        add.ab  #1, sel\n        mod.ab  #2, sel\n        stp.ab  sel, #STATE\n        jmz.b   scan, sel\n        jmp     tbst\nin      dat     0, 0\nsel     dat     0, 0\n\"\"\"\n# label first exec line of tb\ntbb_lines=tbb[:]\ntbb_lines[0]='tbst '+tbb_lines[0].lstrip() if not tbb_lines[0].lstrip().startswith(('sstep','sist')) else tbb_lines[0]\nout=sw+'\\n'.join(body)+'\\n'+'\\n'.join(tbb)+'\\n        end sw\\n'\nopen('sw.red','w').write(out)\nEOF" action.permission=* action.action=allow action.pattern=*
