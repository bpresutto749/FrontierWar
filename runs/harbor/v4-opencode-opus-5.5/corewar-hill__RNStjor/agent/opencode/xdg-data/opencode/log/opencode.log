timestamp=2026-11-14T13:38:40.390Z level=INFO run=e452194b message=evaluated permission=bash pattern="cat > sw2.py <<'EOF'\nimport random,subprocess,sys\nrandom.seed(int(sys.argv[1]))\nT=open('combo2.red').read()\nfor it in range(int(sys.argv[2])):\n    d=[random.randint(200,7800) for _ in range(3)]\n    st=random.choice([3044,3364,2376,3315,1260,3039,5039])\n    nsp=random.choice([0,1,2])\n    s=T.replace(\"<3897\",\"<%d\"%d[0]).replace(\"<1521\",\"<%d\"%d[1]).replace(\"<2110\",\"<%d\"%d[2]).replace(\"equ 3044\",\"equ %d\"%st)\n    s=s.replace(\"start   spl    paper\\n        spl 1\",\"start   spl    paper\\n\"+\"        spl 1\\n\"*nsp)\n    fn=f\"c{sys.argv[1]}.red\"; open(fn,'w').write(s)\n    out=subprocess.run([\"python3\",\"/app/tools/spar.py\",\"--rounds\",\"100\",fn],capture_output=True,text=True).stdout\n    m=float(out.strip().split(\"\\n\")[-1].split()[1])\n    print(m,d,st,nsp,flush=True)\nEOF" action.permission=* action.action=allow action.pattern=*
