timestamp=2026-11-14T13:36:28.769Z level=INFO run=e452194b message=evaluated permission=bash pattern="cat > sweep.py <<'EOF'\nimport random,subprocess,sys\nrandom.seed(int(sys.argv[1]))\nT=open('a4.red').read()\nbest=[]\nfor it in range(int(sys.argv[2])):\n    d=[random.randint(200,7800) for _ in range(3)]; k=random.choice([3,4,5])\n    lines=[\";redcode-94\",\";name x\",\";assert CORESIZE==8000\"]+[\"        spl 1, 0\"]*k\n    b1=random.choice([2667,random.randint(100,7900)]); b2=random.randint(100,7900)\n    lines+=f\"\"\"s1 spl @0, <{d[0]}\n mov.i }}-1, >-1\ns2 spl @0, <{d[1]}\n mov.i }}-1, >-1\ns3 spl @0, <{d[2]}\n mov.i }}-1, >-1\n mov.i bmb, }}{b1}\n mov.i bmb, >{b2}\n mov.i {{-8, <1\n jmz.a @0, }}-9\nbmb dat <2667, <5334\n end\"\"\".split(\"\\n\")\n    fn=f\"sw{sys.argv[1]}.red\"; open(fn,'w').write(\"\\n\".join(lines))\n    out=subprocess.run([\"python3\",\"/app/tools/spar.py\",\"--rounds\",\"100\",fn],capture_output=True,text=True).stdout\n    m=float(out.strip().split(\"\\n\")[-1].split()[1])\n    print(m,k,d,b1,b2,flush=True)\nEOF" action.permission=* action.action=allow action.pattern=*
