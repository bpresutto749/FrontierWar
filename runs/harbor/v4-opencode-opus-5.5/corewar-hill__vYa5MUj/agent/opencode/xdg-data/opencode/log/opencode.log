timestamp=2026-11-14T13:32:57.316Z level=INFO run=0b1d8354 message=evaluated permission=bash pattern="cat > w/two.py <<'EOF'\nimport sys,subprocess,re,random\ndef w(step,half,back,first):\n    return f\"\"\";redcode-94\n;name Lantern\n;author opencode\n;strategy oneshot scanner into spl/dat d-clear\n;assert CORESIZE==8000\nstep    equ     {step}\nhalf    equ     {half}\n        org     top\ngate    dat     0,      0\ntop     add.f   inc,    ptr\nptr     seq.i   {first},  {first}+half\n        jmp     found\n        jmp     top\nfound   mov.ab  ptr,    gate\n        add.ab  #{back},    gate\nclr     spl     #0,     0\n        mov     bmb,    >gate\n        djn.f   -1,     >gate\nbmb     dat     <2667,  12\ninc     dat     step,   step\n        end\n\"\"\"\nif __name__==\"__main__\":\n    random.seed(int(sys.argv[1]))\n    for i in range(int(sys.argv[2])):\n        p=[random.randint(100,7900),random.randint(5,60),-random.randint(1,8)]\n        p.append(p[0]+20)\n        open(f'w/u{sys.argv[1]}.red','w').write(w(*p))\n        o=subprocess.run(['python3','tools/spar.py',f'w/u{sys.argv[1]}.red'],capture_output=True,text=True).stdout\n        m=re.search(r'MEAN\\s+([\\d.]+)',o)\n        print(m.group(1) if m else o[-300:],p,flush=True)\nEOF" action.permission=* action.action=allow action.pattern=*
