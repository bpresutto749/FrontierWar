timestamp=2026-11-14T13:39:22.775Z level=INFO run=0b1d8354 message=evaluated permission=bash pattern="cat > w/gr.py <<'EOF'\nimport sys\nHEAD = \"\"\";redcode-94\n;name Lantern Crane\n;author opencode\n;strategy p-space bandit: picks between a oneshot scanner and a silk paper by mean score\n;assert CORESIZE==8000\n        org     start\nstart   ldp.ab  #0,     res\n        ldp.ab  #6,     last\n        seq.ab  #1,     res\n        jmp     t2\n        mov.ab  #3,     pts\nt2      seq.ab  #2,     res\n        jmp     t3\n        mov.ab  #1,     pts\nt3      slt.ab  #3,     res\n        jmp     upd\n        jmp     choose\nupd     mov.b   last,   ia\n        mul.ab  #2,     ia\n        add.ab  #2,     ia\n        mov.b   ia,     ib\n        add.ab  #1,     ib\n        ldp.b   ia,     s\n        ldp.b   ib,     n\n        add.b   pts,    s\n        add.ab  #1,     n\n        slt.ab  #DECAY,   n\n        jmp     nod\n        div.ab  #2,     n\n        div.ab  #2,     s\nnod     stp.b   s,      ia\n        stp.b   n,      ib\nchoose  ldp.ab  #2,     s0\n        ldp.ab  #3,     n0\n        ldp.ab  #4,     s1\n        ldp.ab  #5,     n1\n        slt.ab  #EXPL,     n0\n        jmp     pick0\n        slt.ab  #EXPL,     n1\n        jmp     pick1\n        mul.ab  #MULT,    s0\n        div.b   n0,     s0\n        mul.ab  #MULT,    s1\n        div.b   n1,     s1\n        slt.b   s0,     s1\n        jmp     pick0\npick1   stp.ab  #1,     #6\n        jmp     top\npick0   stp.ab  #0,     #6\n        jmp     p0\nres     dat     0,      0\nlast    dat     0,      0\npts     dat     0,      0\nia      dat     0,      0\nib      dat     0,      0\ns       dat     0,      0\nn       dat     0,      0\ns0      dat     0,      0\nn0      dat     0,      0\ns1      dat     0,      0\nn1      dat     0,      0\n\"\"\"\ndef one(step=3082, half=34, back=-6):\n    return f\"\"\"step    equ     {step}\nhalf    equ     {half}\ngate    dat     0,      0\ntop     add.f   inc,    ptr\nptr     seq.i   step+20,  step+20+half\n        jmp     found\n        jmp     top\nfound   mov.ab  ptr,    gate\n        add.ab  #{back},    gate\nclr     spl     #0,     0\n        mov     bmb,    >gate\n        djn.f   -1,     >gate\nbmb     dat     <2667,  12\ninc     dat     step,   step\n\"\"\"\ndef paper(pp=(495,2736,259,830,1085)):\n    return f\"\"\"p0      spl     1\n        spl     1\n        spl     1\np1      spl     @0,     }}{pp[0]}\n        mov.i   }}p1,    >p1\np2      spl     @0,     }}{pp[1]}\n        mov.i   }}p2,    >p2\n        mov.i   pb,    >{pp[2]}\n        mov.i   pb,    }}{pp[3]}\n        mov.i   {{p2,    <p3\np3      jmp     @0,     >{pp[4]}\npb      dat     <2667,  <5334\n\"\"\"\ndef w(decay=100, expl=7, mult=25, gap=6):\n    h=HEAD.replace(\"DECAY\",str(decay)).replace(\"EXPL\",str(expl)).replace(\"MULT\",str(mult))\n    return h+one()+\"        for %d\\n        dat 0,0\\n        rof\\n\"%gap+paper()+\"        end\\n\"\nif __name__==\"__main__\":\n    print(w())\nEOF" action.permission=* action.action=allow action.pattern=*
