timestamp=2026-11-14T13:34:35.777Z level=INFO run=0b1d8354 message=evaluated permission=bash pattern="cat > w/sw.py <<'EOF'\nimport sys\ndef w(mode=\"loss\", step=3082, half=34, back=-6):\n    cond = \"jmn.b   keep,   res\" if mode==\"loss\" else \"seq.ab  #1, res\\n        jmp     flip\\n        jmp     keep\"\n    return f\"\"\";redcode-94\n;name Lantern Crane\n;author opencode\n;strategy p-space switch between a oneshot scanner and silk paper\n;assert CORESIZE==8000\nST      equ     77\nstep    equ     {step}\nhalf    equ     {half}\n        org     start\nstart   ldp.b   #0,     res\n        ldp.b   #ST,    sel\n        {cond}\nflip    add.b   #1,     sel\nkeep    mod.b   #2,     sel\n        stp.b   sel,    #ST\n        jmz.b   p0,     sel\n        jmp     top\nres     dat     0,      0\nsel     dat     0,      0\ngate    dat     0,      0\ntop     add.f   inc,    ptr\nptr     seq.i   step+20,  step+20+half\n        jmp     found\n        jmp     top\nfound   mov.ab  ptr,    gate\n        add.ab  #{back},    gate\nclr     spl     #0,     0\n        mov     bmb,    >gate\n        djn.f   -1,     >gate\nbmb     dat     <2667,  12\ninc     dat     step,   step\n        for 6\n        dat 0,0\n        rof\np0      spl     1\n        spl     1\n        spl     1\np1      spl     @0,     }}495\n        mov.i   }}p1,    >p1\np2      spl     @0,     }}2736\n        mov.i   }}p2,    >p2\n        mov.i   pb,    >259\n        mov.i   pb,    }}830\n        mov.i   {{p2,    <p3\np3      jmp     @0,     >1085\npb      dat     <2667,  <5334\n        end\n\"\"\"\nif __name__==\"__main__\":\n    print(w(sys.argv[1]))\nEOF" action.permission=* action.action=allow action.pattern=*
