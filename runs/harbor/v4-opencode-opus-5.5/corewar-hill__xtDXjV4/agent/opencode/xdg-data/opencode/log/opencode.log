timestamp=2026-11-14T13:41:03.011Z level=INFO run=bf8b2453 message=evaluated permission=bash pattern="cat > qp.py <<'EOF'\nimport sys\nN=int(sys.argv[1]); E=int(sys.argv[2]); nb=int(sys.argv[3]); sp=int(sys.argv[4]) if len(sys.argv)>4 else 0\nAs=[\"3100\",\"5420\"]\nout=[\";redcode-94\",\";name Folded Sheets Q\",\";author opencode\",\";strategy quick-scan, then two silk papers\",\";assert CORESIZE==8000\",\"        org    qs\"]\n# offsets spread over [200, 200+E) region excluding own\noffs=[ 150 + (i*(E-200))//N for i in range(N)]\nfirst=True\nfor o in offs:\n    lab=\"qs      \" if first else \"        \"; first=False\n    out.append(f\"{lab}seq.i  qs+{o}, qs+{o+E}\")\n    out.append(f\"        mov.ab #qs+{o}-qp, qp\")\nout.append(\"        jmz.b  boot, qp\")\nout.append(\"        jmn.f  att, @qp\")\nout.append(f\"        add.ab #{E}, qp\")\nout.append(f\"att     sub.ab #{nb//2}, qp\")\nout.append(f\"aloop   mov    qb, >qp\")\nout.append(f\"        djn    aloop, #{nb}\")\nout.append(\"        jmp    boot\")\nout.append(\"qp      dat    0, 0\")\nout.append(\"qb      dat    >-1, >1\" if not sp else \"qb      spl    #0, 0\")\nout.append(\"boot    spl    q1\")\nfor i,A in enumerate(As):\n    n=f\"q{i}\"\n    out.append((f\"{n}      \" if i>0 else \"        \")+\"spl    1\")\n    out.append(\"        spl    1\\n        spl    1\")\n    out.append(f\"\"\"{n}s     spl    @0, >{A}\n        mov    }}-1, >-1\n        mov    {n}b, >1949\n        mov    {n}b, }}2340\n        mov    {{{n}s, <{n}s\n        jmz.a  @0, {n}s\n{n}b     dat    <2667, <5334\"\"\")\nprint(\"\\n\".join(out))\nEOF" action.permission=* action.action=allow action.pattern=*
