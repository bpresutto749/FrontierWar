timestamp=2026-11-14T13:45:46.776Z level=INFO run=bf8b2453 message=evaluated permission=bash pattern="python3 - <<'EOF'\nbest=open('best.red').read().split('\\n')\nbody=[l for l in best if l and not l.startswith(';')]\nimp=open('imponly.red').read().split('\\n')[2:]\nscan=[l for l in open('scan4.red').read().split('\\n') if l and not l.startswith(';') and 'org' not in l]\ndef mk(alt, altlabel, name):\n    out=[\";redcode-94\",\";name Folded Switch\",\";author opencode\",\";strategy p-space switcher: two silk papers, switch to alternate after a loss\",\";assert CORESIZE==8000\",\"        org    pstart\",\n\"PSLOT   equ    77\",\n\"pstart  ldp.a  #0, res\",\n\"        ldp.a  #PSLOT, sel\",\n\"        sne.ab #0, res\",\n\"        add.a  #1, sel\",\n\"        mod.a  #2, sel\",\n\"        stp.a  sel, #PSLOT\",\n\"sel     jmz.a  paper, #0\",\n\"        jmp    \"+altlabel,\n\"res     dat    0, 0\"]\n    b=list(body); b[0]=\"paper   \"+b[0].strip()\n    out+=b+alt\n    open(name,'w').write(\"\\n\".join(out)+\"\\n\")\nmk([l for l in imp if l], \"imps\", \"swi.red\")\nsc=list(scan); sc[0]=\"sloop\"+sc[0][4:]\nsc=[l.replace(\"loop\",\"sloop\") if l.strip().startswith((\"djn\",\"jmz\")) or \"loop,\" in l else l for l in sc]\nmk(sc, \"sloop\", \"sws.red\")\nEOF" action.permission=* action.action=allow action.pattern=*
