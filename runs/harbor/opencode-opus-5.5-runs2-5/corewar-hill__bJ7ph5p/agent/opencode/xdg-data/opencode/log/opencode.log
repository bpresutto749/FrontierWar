timestamp=2026-11-14T12:35:43.459Z level=INFO run=3806dc20 message=evaluated permission=bash pattern="cat > sweep.py <<'E'\nimport random,subprocess,sys,re\ndef gen(a,b,c,d,e,f,n):\n    s=\";redcode-94\\n;name Mulberry\\n;author anon\\n;assert CORESIZE==8000\\n\"\n    s+=\"        spl 1, <-200\\n\"*n\n    s+=f\"\"\"s1      spl @0, }}{a}\n        mov }}s1, >s1\ns2      spl @0, }}{b}\n        mov }}s2, >s2\ns3      spl @0, }}{c}\n        mov }}s3, >s3\n        mov.i #1, {{{d}\n        mov s3+1, <{e}\n        jmp s3, <{f}\n\"\"\"\n    return s\ndef score(src,r=100):\n    open('t.red','w').write(src)\n    o=subprocess.run(['python3','/app/tools/spar.py','--rounds',str(r),'t.red'],capture_output=True,text=True).stdout\n    return float(o.strip().split()[-1])\nbest=[]\nrandom.seed(int(sys.argv[1]))\nfor i in range(int(sys.argv[2])):\n    p=[random.randint(100,7900) for _ in range(6)]+[random.choice([3,4])]\n    s=score(gen(*p))\n    best.append((s,p)); print(s,p,flush=True)\nbest.sort(reverse=True)\nfor s,p in best[:5]: print('TOP',s,p, score(gen(*p),300))\nE" action.permission=* action.action=allow action.pattern=*
