timestamp=2026-11-14T12:40:24.242Z level=INFO run=3806dc20 message=evaluated permission=bash pattern="cat > sw.py <<'E'\nimport sys\na,b,c,d,e,f=[int(x) for x in sys.argv[1:7]]\nprint(f\"\"\";redcode-94\n;name Mulberry Flint\n;author anon\n;assert CORESIZE==8000\nSTORE   equ 37\nstep    equ 3364\n        org start\nstart   ldp.ab #0, in\n        ldp.a #STORE, sel\n        sne.ab #0, in\n        add.a #1, sel\n        mod.a #2, sel\n        stp.ab sel, #STORE\nsel     jmp @0, paper\n        dat 0, stone\nin      dat 0, 0\npaper   spl 1, <-200\n        spl 1, <-300\n        spl 1, <-400\ns1      spl @0, }}{a}\n        mov }}s1, >s1\ns2      spl @0, }}{b}\n        mov }}s2, >s2\ns3      spl @0, }}{c}\n        mov }}s3, >s3\n        mov.i #1, {{{d}\n        mov s3+1, <{e}\n        jmp s3, <{f}\n        dat 0, 0\n        dat 0, 0\ninc     dat step*2, step*2\nstn     spl #0, 0\nloop    add.f inc, ptr\n        mov bmb, @ptr\n        mov bmb, *ptr\n        djn.f loop, <-1500\nptr     dat 0, step\nbmb     dat >-1, >1\nstone   spl stn\n        spl 1\n        mov -1, 0\n        spl 1\n        jmp }}t\nt       dat 1, 0\n        jmp imp\n        jmp imp+2667\n        jmp imp+5334\nimp     mov.i #1, 2667\n\"\"\")\nE" action.permission=* action.action=allow action.pattern=*
