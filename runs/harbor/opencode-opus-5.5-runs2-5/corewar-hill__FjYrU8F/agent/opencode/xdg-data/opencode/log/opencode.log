timestamp=2026-11-14T12:37:41.995Z level=INFO run=5d495949 message=evaluated permission=bash pattern="cat > gens.py <<'E'\nimport random,subprocess,sys,os\ndef stone(s,o,imp=True):\n    imps = \"\"\"imps    spl 1\n        spl 1\n        spl 1\n        spl 2\n        jmp @0, imp\n        add #2667, -1\nimp     mov.i #2667, *0\n\"\"\" if imp else \"\"\n    return f\"\"\";redcode-94\n;name Grey Pebble\n;author opencode\n;assert CORESIZE==8000\n{\"        spl imps\" if imp else \"\"}\n        spl #0, 0\nloop    mov bmb, @p\n        mov bmb, *p\n        add.f inc, p\n        djn.f loop, <-{o}\np       dat {s}, {2*s}\ninc     dat {2*s}, {2*s}\nbmb     dat >1, >1\n{imps}\"\"\"\ndef score(src,r=100):\n    fn='/tmp/w/s%d_%d.red'%(os.getpid(),random.random()*1e9)\n    open(fn,'w').write(src)\n    o=subprocess.run(['python3','/app/tools/spar.py',fn,'--rounds',str(r)],capture_output=True,text=True).stdout\n    return float(o.strip().split('\\n')[-1].split()[-1])\nif __name__=='__main__':\n  random.seed(int(sys.argv[1]))\n  for i in range(int(sys.argv[2])):\n    s=random.randint(50,3999); o=random.randint(5,500); imp=random.random()<0.5\n    print(score(stone(s,o,imp)),s,o,imp,flush=True)\nE" action.permission=* action.action=allow action.pattern=*
