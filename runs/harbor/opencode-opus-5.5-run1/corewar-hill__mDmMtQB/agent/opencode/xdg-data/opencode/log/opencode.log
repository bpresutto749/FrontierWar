timestamp=2026-11-14T12:27:06.446Z level=INFO run=a15e2186 message=evaluated permission=bash pattern="cat > ps.red <<'EOF'\n;redcode-94\n;name Folded Grit\n;author opencode\n;strategy p-space switcher: silk paper / stone+imp, switch on loss\n;assert CORESIZE==8000\nSTR     equ 7\nstep    equ 3364\n        org think\nthink   ldp.ab #0, res\n        ldp.ab #STR, str\n        sne.ab #0, res\n        add.ab #1, str\n        mod.ab #2, str\n        stp.ab str, #STR\n        jmz.b pstart, str\n        jmp sstart\nres     dat 0, 0\nstr     dat 0, 0\n\npstart  spl 1\n        spl 1\n        spl 1\n        spl 1\np1      spl @0, }2364\n        mov.i }-1, >-1\np2      spl @0, }4760\n        mov.i }-1, >-1\np3      spl @0, }1308\n        mov.i }-1, >-1\n        mov.i #1, <1\n        mov.i pbmb, {2667\n        jmp -3, <-1400\npbmb    dat <2667, <5334\n\nsstart  spl stone\n        spl imps\n        jmp stone\nstone   spl #0, <-200\nloop    mov bomb, @ptr\nptr     mov bomb, *step\n        add #step*2, ptr\n        djn.f loop, <-300\nbomb    dat >2667, }1\n        for 5\n        dat 0,0\n        rof\nimps    spl 1\n        spl 1\n        spl 1\n        spl 2\n        jmp @0, imp\n        add #2667, -1\n        dat 0,0\nimp     mov.i #2667, *0\nEOF" action.permission=* action.action=allow action.pattern=*
