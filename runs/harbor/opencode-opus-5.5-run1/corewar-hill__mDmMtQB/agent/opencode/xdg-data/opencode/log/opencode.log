timestamp=2026-11-14T12:28:04.504Z level=INFO run=a15e2186 message=evaluated permission=bash pattern="cat > gen2.py <<'EOF'\nimport sys\nnspl=int(sys.argv[1]); steps=sys.argv[2].split(','); bs=sys.argv[3]; tail=sys.argv[4]\no=[\";redcode-94\",\";name Folded Silk\",\";author opencode\",\";assert CORESIZE==8000\",\"        org start\",\"start   spl 1\"]\no+=[\"        spl 1\"]*(nspl-1)\nfor s in steps:\n    o+=[f\"        spl @0, }}{s}\",\"        mov.i }-1, >-1\"]\nif tail=='a':\n    o+=[\"        mov.i #1, <1\",f\"        mov.i pbmb, {{{bs}\",\"        jmp -3, <-1400\",\"pbmb    dat <2667, <5334\"]\nelif tail=='b':\n    o+=[f\"        mov.i pbmb, >{bs}\",\"        mov.i pbmb, }-1\",\"        jmp -2, <-1400\",\"pbmb    dat <2667, <5334\"]\nelif tail=='c':\n    o+=[\"        mov.i #1, <1\",f\"        mov.i pbmb, {{{bs}\",\"        jmp -3, <-1400\",\"pbmb    spl #0, <5334\"]\nprint(\"\\n\".join(o))\nEOF" action.permission=* action.action=allow action.pattern=*
